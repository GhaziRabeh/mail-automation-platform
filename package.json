{
  "name": "mail-automation",
  "version": "1.0.0",
  "description": "Cold Email Automation Platform",
  "main": "dist/api/server.js",

  "scripts": {
    "dev": "nodemon",

    "api": "tsx src/api/server.ts",
    "worker": "tsx src/worker.server.ts",
    "mail": "tsx src/mail.server.ts",

    "build": "tsc",

    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker.server.js",
    "start:mail": "node dist/mail.server.js",

    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",

    "seed": "tsx prisma/seed.ts"
  },

  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.6.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.14",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.0.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5"
  },

  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/socket.io": "^3.0.1",
    "@types/validator": "^13.15.10",

    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
